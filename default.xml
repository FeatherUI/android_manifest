<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!-- Google AOSP Remote -->
  <remote name="aosp" fetch="https://android.googlesource.com" />
  
  <!-- FeatherUI GitHub Remote -->
  <remote name="feather" fetch="https://github.com/FeatherUI-OS" />

  <!-- Target Android version -->
  <default revision="refs/tags/android-14.0.0_r1" remote="aosp" sync-j="4" />

  <!-- Pull in official Android source tree -->
  <include name="default.xml" />

  <!-- Pull in custom FeatherUI vendor repository into vendor/feather -->
  <project path="vendor/feather" name="vendor_feather" remote="feather" revision="main" />
</manifest>
